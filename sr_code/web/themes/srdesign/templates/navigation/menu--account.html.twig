{#
/**
 * @file
 * Theme override to display a menu.
 *
 * Available variables:
 * - menu_name: The machine name of the menu.
 * - items: A nested list of menu items. Each menu item contains:
 *   - attributes: HTML attributes for the menu item.
 *   - below: The menu item child items.
 *   - title: The menu link title.
 *   - url: The menu link url, instance of \Drupal\Core\Url
 *   - localized_options: Menu link localized options.
 *   - is_expanded: TRUE if the link has visible children within the current
 *     menu tree.
 *   - is_collapsed: TRUE if the link has children within the current menu tree
 *     that are not currently visible.
 *   - in_active_trail: TRUE if the link is in the active trail.
 */
#}

<ul
	aria-labelledby="profileDropdown" {{ attributes.addClass('menu', 'dropdown-menu', 'dropdown-animation', 'dropdown-menu-end', 'shadow', 'pt-3', 'pb-3') }}>
	<!-- Profile info -->
	<li class="px-3 mb-2">
		<div
			class="d-flex align-items-center">
			<!-- Avatar -->
			<div class="avatar me-3">
				<i class="fa-regular fa-id-card"></i>
			</div>
			<div>
				<a class="h6 mt-2 mt-sm-0" href="#">{{ user_first_name }}
					{{ user_last_name }}</a>
				<p class="small m-0 text-break">{{ user_mail }}</p>

				{% if sr_admin_link != '' %}
					<p class="small m-0 text-break">{{ sr_admin_link }}</p>
				{% endif %}

			</div>
		</div>
	</li>
	<!-- Links -->
	<li>
		<hr class="dropdown-divider">
	</li>
	{% import _self as menus %}

	{#
	  We call a macro which calls itself to render the full tree.
	  @see https://twig.symfony.com/doc/3.x/tags/macro.html
	#}
	{{ menus.menu_links(items, attributes, 0, country_code) }}

	{% macro menu_links(items, attributes, menu_level, country_code) %}

		{% import _self as menus %}
		{% if items %}
			{% for item in items %}
				{%
        set classes = [
          'menu-item',
          item.is_expanded ? 'menu-item--expanded',
          item.is_collapsed ? 'menu-item--collapsed',
          item.in_active_trail ? 'menu-item--active-trail',
        ]
      %}
		<li{{item.attributes.addClass(classes)}}>
        
					{% if item.title == 'Log in' %}
						{% if country_code == 'ae' or country_code == 'sa' %}
							{{ link('Agent Log in/Register', item.url, { 'class':['dropdown-item'] }) }}
						{% else %}
							{{ link('Log in/Register', item.url, { 'class':['dropdown-item'] }) }}
						{% endif %}
					{% else %}
						{{ link(item.title, item.url, { 'class':['dropdown-item'] }) }}
					{% endif %}
					{% if item.below %}
						{{ menus.menu_links(item.below, attributes, menu_level + 1, country_code) }}
					{% endif %}
				</li>
			{% endfor %}

		{% endif %}

	{% endmacro %}
</ul>