<div class="quotation-dashboard-page">

	<div class="dashboard-card">
		<h2 class="dashboard-title">{{ 'Quotation Dashboard'|t }}</h2>
		<div class="dashboard-card-header">
			<div class="dashboard-actions">
				<a href="{{ add_link }}" class="btn add-btn">
					<i class="fas fa-plus"></i>
					{{ 'Add Quotation'|t }}
				</a>
			</div>
		</div>

		{% if quotations is not empty %}
			<div class="table-wrap">
				<table class="quotation-table">
					<thead>
						<tr>
							<th class="col-action">Action</th>
							<th class="col-title">Title</th>
							<th class="col-location">Location</th>
							<th class="col-checkin">Check-in</th>
							<th class="col-checkout">Check-out</th>
							<th class="col-created">Created</th>
							<th class="col-pdf">PDF</th>
							{# 🆕 New column for preview/download #}
						</tr>
					</thead>

					<tbody>
						{% for item in quotations %}
							<tr>
								<td class="col-action">
									<div class="dropdown action-dropdown">
										<button class="dropdown-toggle">
											<i class="fas fa-edit"></i>
											{{ 'Edit'|t }}
											{# <i class="fas fa-caret-down dropdown-arrow"></i> #}
										</button>
										<div class="dropdown-menu">
											<a href="{{ path('sr_quotation.edit', {'id': item.id}) }}" class="dropdown-item">
												<i class="fas fa-edit"></i>
												{{ 'Edit'|t }}
											</a>

											<a href="{{ path('sr_quotation.duplicate', {'id': item.id}) }}" class="dropdown-item">
												<i class="fas fa-copy"></i>
												{{ 'Duplicate'|t }}
											</a>

											<a href="{{ path('sr_quotation.delete', {'id': item.id}) }}"
                        class="dropdown-item delete-item"
                        onclick="openDeleteModal('{{ path('sr_quotation.delete', {'id': item.id}) }}'); return false;">
                        <i class="fas fa-trash-alt"></i> {{ 'Delete'|t }}
                      </a>
										</div>
									</div>
								</td>

								<td class="col-title">{{ item.title }}</td>
								<td class="col-location">{{ item.location }}</td>
								<td class="col-checkin">{{ item.checkin_date|date("d-m-Y") }}</td>
								<td class="col-checkout">{{ item.checkout_date|date("d-m-Y") }}</td>
								<td class="col-created">{{ item.created|date("d-m-Y") }}</td>

								{# 🆕 New PDF Column #}
								<td class="col-pdf">
									<div class="pdf-actions">
										<a href="{{ path('sr_quotation.preview', {'id': item.id}) }}" class="btn-preview" target="_blank">
											<i class="fas fa-eye"></i>
											{{ 'Preview'|t }}
										</a>

										<a href="{{ path('sr_quotation.download', {'id': item.id}) }}" class="btn-download" target="_blank">
											<i class="fas fa-file-download"></i>
											{{ 'Download'|t }}
										</a>
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<div class="no-data">{{ 'No quotations available.'|t }}</div>
		{% endif %}
	</div>
</div>

<div id="deleteModal" class="delete-modal-overlay">
  <div class="delete-modal">
    <h3>{{ 'Confirm Delete'|t }}</h3>
    <p>{{ 'Are you sure you want to delete this quotation?'|t }}</p>

    <div class="delete-modal-actions">
      <button class="btn-cancel" onclick="closeDeleteModal()">
        {{ 'Cancel'|t }}
      </button>

      <a id="deleteConfirmBtn" href="#" class="btn-delete">
        {{ 'Delete'|t }}
      </a>
    </div>
  </div>
</div>

<script>
	document.addEventListener("click", function (e) {
const toggle = e.target.closest(".dropdown-toggle");

// Close all dropdowns when clicking outside
if (! toggle) {
document.querySelectorAll(".dropdown-menu").forEach(menu => menu.style.display = "none");
return;
}

const menu = toggle.nextElementSibling;

// Toggle the dropdown
if (menu.style.display === "block") {
menu.style.display = "none";
} else {
document.querySelectorAll(".dropdown-menu").forEach(m => m.style.display = "none"); // Close others
menu.style.display = "block";
}
});

function openDeleteModal(url) {
  document.getElementById('deleteModal').style.display = 'flex';
  document.getElementById('deleteConfirmBtn').setAttribute('href', url);
}

function closeDeleteModal() {
  document.getElementById('deleteModal').style.display = 'none';
}

document.addEventListener('click', function(e) {
  // Close popup if clicking outside modal
  if (e.target.classList.contains('delete-modal-overlay')) {
    closeDeleteModal();
  }
});
</script>
