<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>Quotation</title>

		<style>

			body {
				margin: 0;
				padding: 0;
				font-family: Poppins, Arial, sans-serif;
				background-color: #f9f9f9;
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}

			.container {
				width: 100%;
				padding: 20px;
			}

			.row {
				width: 100%;
				clear: both;
			}

			.col-12 {
				width: 100%;
				display: block;
			}

			.mb-5 {
				margin-bottom: 30px;
			}

			.text-center {
				text-align: center;
			}

			.quote-wrapper,
			.property-hero {
				border-radius: 16px;
			}

			.property-hero {
				width: 100%;
				height: auto;
				display: block;
			}

			.quote-wrapper {
				border: 2px solid #babecb;
				background: #ffffff;
				padding: 25px;
				margin-bottom: 30px;
				position: relative;
				color: #192452;
				page-break-inside: avoid;
			}

			.quote-wrapper h2 .section-title {
				position: relative;
				margin: 0;
				line-height: 60px;
				font-weight: 200;
			}

			.quote-wrapper h4 .testing {
				padding-bottom: 100px;
			}

			.quote-wrapper .title-table .h6 {
				font-size: 40px;
				font-family: "Merriweather", serif;
				font-weight: normal;
				color: #192452;
				position: absolute;
			}

			table .title-table {
				padding-bottom: 100px;
				margin-bottom: 30px;
			}

			.pdf-table {
				width: 100%;
				border-collapse: collapse;
				margin-top: 20px;
			}

			.pdf-table td {
				width: 50%;
				vertical-align: top;
				padding-bottom: 16px;
			}

			.pdf-label {
				color: #0B8D9F;
				font-weight: 600;
				display: block;
				margin-bottom: 4px;
				font-weight: bold;
			}

			.pdf-value {
				color: #192452;
			}

			.list-columns {
				column-count: 2;
				column-gap: 40px;
				padding-left: 0;
				list-style: none;
			}

			.list-columns li {
				break-inside: avoid;
				padding-bottom: 12px;
			}

			.list-columns li span {
				color: #0B8D9F;
				font-weight: bold;
				display: inline-block;
				min-width: 160px;
			}

			.image-box {
				width: 300px;
				height: 169px;
				border-radius: 16px;
				border: 1px solid #cf0b2b;
				padding: 10px;
				overflow: hidden;
				box-sizing: border-box;
			}

			.image-box img {
				width: 100%;
				height: 100%;
				aspect-ratio: 16 / 9;
				border-radius: 8px;
				display: block;
				object-fit: cover;
			}
		</style>
	</head>

	<body>

		{# <div class="container">
					
					<img src="https://stayrelive.com/sites/default/files/inline-images/pdf-hero-img.png" class="property-hero" alt="Hero Image">
				</div> #}

   <div class="container">
      <div class="row">
         <div class="col-12">
					<h2 class="main-title" style="font-weight: normal; color: #192452; padding: 10px 20px; margin: 0; font-family: 'Merriweather', serif; font-size: 45px; text-align: center;">Booking Details</h2>
         </div>
      </div>

			<!-- BOOKING DETAILS -->
			<div class="quote-wrapper">


				<table class="title-table">

					<tr>
						<td rowspan="3">
							<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-bespoke.png">

						</td>
						<td></td>
						<td></td>
					</tr>

					<tr>
						<td rowspan="3">

							<h6 class="title-text" style="font-size: 25px; color: #192452; font-family: 'Merriweather', serif; font-weight: normal;">Booking Information</h6>

						</td>
						<td></td>
					</tr>

					<tr>
						<td rowspan=""></td>
						<td></td>

					</tr>
					<tr>
						<td rowspan=""></td>

					</tr>


				</table>

				<table class="pdf-table">
					<tr>
						<td>
							<span class="pdf-label">Booker Name:</span>
							<br>
							<span class="pdf-value">{{ data.booker_name|upper }}</span>
						</td>
						<td>
							<span class="pdf-label">Travel Partner / Corporate:</span>
							<br>
							<span class="pdf-value">{{ data.travel_partner }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Check-in Time:</span>
							<br>
							<span class="pdf-value">{{ data.checkin_time }}</span>
						</td>
						<td>
							<span class="pdf-label">Check-out Time:</span>
							<br>
							<span class="pdf-value">{{ data.checkout_time }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Check-in Date:</span>
							<br>
							<span class="pdf-value">{{ data.checkin_date }}</span>
						</td>
						<td>
							<span class="pdf-label">Check-out Date:</span>
							<br>
							<span class="pdf-value">{{ data.checkout_date }}</span>
						</td>

					</tr>

					<tr>
						<td>
							<span class="pdf-label">Number of Nights:</span>
							<br>
							<span class="pdf-value">{{ data.nights }}</span>
						</td>
						<td>
							<span class="pdf-label">StayRelive Agent Name:</span>
							<br>
							<span class="pdf-value">{{ data.agent_name }}</span>
						</td>
					</tr>
					<tr>
						<td>
							<span class="pdf-label">StayRelive Agent Contact Num:</span>
							<br>
							<span class="pdf-value">{{ data.agent_phone }}</span>
						</td>
						<td>
							<span class="pdf-label">StayRelive Agent Email:</span>
							<br>
							<span class="pdf-value">{{ data.agent_email }}</span>
						</td>
					</tr>
				</table>
                </div>
                
			<!-- PROPERTY INFORMATION -->
			<div class="quote-wrapper">

				<table class="title-table">

					<tr>
						<td rowspan="3">
							<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-bespoke.png">

						</td>
						<td></td>
						<td></td>
					</tr>

					<tr>
						<td rowspan="3">

							<h6 class="title-text" style="font-size: 25px; color: #192452; font-family: 'Merriweather', serif; font-weight: normal;">Property Information</h6>

						</td>
						<td></td>
					</tr>

					<tr>
						<td rowspan="3"></td>
						<td></td>

					</tr>


				</table>
				<table class="pdf-table">
					<tr>
						<td>
							<span class="pdf-label">Unit Type:</span>
							<br>
							<span class="pdf-value">{{ data.unit_type }}</span>
						</td>
						<td>
							<span class="pdf-label">Room Type:</span>
							<br>
							<span class="pdf-value">{{ data.room_type }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Room Category:</span>
							<br>
							<span class="pdf-value">{{ data.room_category }}</span>
						</td>
						<td>
							<span class="pdf-label">Bathrooms:</span>
							<br>
							<span class="pdf-value">{{ data.bathrooms }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Apartment Size:</span>
							<br>
							<span class="pdf-value">{{ data.apartment_size }}</span>
						</td>
						<td>
							<span class="pdf-label">Adults:</span>
							<br>
							<span class="pdf-value">{{ data.adults }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Kids:</span>
							<br>
							<span class="pdf-value">{{ data.kids }}</span>
						</td>
						<td>
							<span class="pdf-label">Location:</span>
							<br>
							<span class="pdf-value">{{ data.location }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Distance:</span>
							<br>
							<span class="pdf-value">{{ data.distance }}</span>
						</td>
						<td>
							<span class="pdf-label">Map Link:</span>
							<br>
							<span class="pdf-value">{{ data.map_link }}</span>
						</td>
					</tr>
				</table>
                  </div>
                  
               </div>


		<!-- PRICING -->
		<div class="quote-wrapper">

			<table class="title-table">

				<tr>
					<td rowspan="3">
						<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-bespoke.png">

					</td>
					<td></td>
					<td></td>
				</tr>

				<tr>
					<td rowspan="3">

						<h6 class="title-text" style="font-size: 25px; color: #192452; font-family: 'Merriweather', serif; font-weight: normal;">Pricing & Financials</h6>

					</td>
					<td></td>
				</tr>

				<tr>
					<td rowspan="3"></td>
					<td></td>

				</tr>


			</table>
			<table class="pdf-table">
				<tr>
					<td>
						<span class="pdf-label">Quote:</span>
						<br>
						<span class="pdf-value">{{ data.quote }}</span>
					</td>
					<td>
						<span class="pdf-label">Taxes:</span>
						<br>
						<span class="pdf-value">{{ data.taxes }}</span>
					</td>
				</tr>

				<tr>
					<td>
						<span class="pdf-label">FX Rate:</span>
						<br>
						<span class="pdf-value">{{ data.fx_rate }}</span>
					</td>
					<td>
						<span class="pdf-label">Currency:</span>
						<br>
						<span class="pdf-value">{{ data.currency }}</span>
					</td>
				</tr>

				<tr>
					<td>
						<span class="pdf-label">Add-ons:</span>
						<br>
						<span class="pdf-value">{{ data.addon_prices ?: 'N/A' }}</span>
					</td>
					<td></td>
				</tr>
			</table>
            </div>

		<div
			class="quote-wrapper">

			<!-- ===== Amenities Title ===== -->
			<table class="title-table">
				<tr>
					<td rowspan="3">
						<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-bespoke.png">
					</td>
					<td></td>
					<td></td>
				</tr>

				<tr>
					<td rowspan="3">
						<h6 class="title-text" style="font-size: 25px; color: #192452; font-family: 'Merriweather', serif; font-weight: normal;">
							Amenities
						</h6>
					</td>
					<td></td>
				</tr>

				<tr>
					<td rowspan="3"></td>
					<td></td>
				</tr>
			</table>

			<!-- ===== Amenities List (PDF SAFE) ===== -->
			{% if data.amenities %}
                        {% set amenities_list = data.amenities|split(',') %}

				<table width="100%" cellpadding="0" cellspacing="0" style="margin-top: 10px;">
                           {% for amenity in amenities_list %}
                              {% set amenity_trimmed = amenity|trim %}
                              {% if amenity_trimmed %}

							{% if loop.index0 is even %}
								<tr>
								{% endif %}

								<td width="50%" style="padding-bottom: 10px; vertical-align: top;">
									<span style="color:#0B8D9F; font-weight:bold;">✔</span>
									<span style="color:#192452; font-size:14px;">
										{{ amenity_trimmed }}
									</span>
								</td>

								{% if loop.index0 is odd or loop.last %}
								</tr>
							{% endif %}

                              {% endif %}
                           {% endfor %}
				</table>

                     {% else %}
				<p style="color:#999;">No amenities selected.</p>
                     {% endif %}

                  </div>


		<!-- POLICIES -->
		<div class="quote-wrapper">


			<table class="title-table">

				<tr>
					<td rowspan="3">
						<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-bespoke.png">

					</td>
					<td></td>
					<td></td>
				</tr>

				<tr>
					<td rowspan="3">

						<h6 class="title-text" style="font-size: 25px; color: #192452; font-family: 'Merriweather', serif; font-weight: normal;">Policies</h6>

					</td>
					<td></td>
				</tr>

				<tr>
					<td rowspan="3"></td>
					<td></td>

				</tr>


			</table>

			<table class="pdf-table">
				<tr>
					<td>
						<span class="pdf-label">Cancellation Policy:</span>
						<br>

						<span class="pdf-value">{{ data.cancellation_policy|raw }}</span>
					</td>
				</tr>

				<tr>
					<td>
						<span class="pdf-label">Rules:</span>
						<br>
						<span class="pdf-value">{{ data.rules|raw }}</span>

					</td>
				</tr>

				<tr>
					<td colspan="2">
						<span class="pdf-label">Notes:</span>
						<br>
						<span class="pdf-value">{{ data.note|raw }}</span>
					</td>
				</tr>
			</table>
               </div>

		<!-- PROPERTY IMAGES -->
         {% if image_urls %}
			<div class="quote-wrapper">

				<table class="title-table">

					<tr>
						<td rowspan="3">
							<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-safety.png">

						</td>
						<td></td>
						<td></td>
					</tr>

					<tr>
						<td rowspan="3">

							<h6 class="title-text" style="font-size: 25px; color: #192452; font-family: 'Merriweather', serif; font-weight: normal;">Property Images</h6>

						</td>
						<td></td>
					</tr>

					<tr>
						<td rowspan="3"></td>
						<td></td>
						<td></td>
						<td></td>

					</tr>


				</table>

				<div style="padding-top: 30px;">
					<table width="100%" cellpadding="10" cellspacing="0">
						{% set all_images = image_urls|merge(location_screenshot_urls) %}

						{% for image in all_images %}
							{% if loop.index0 is even %}
								<tr>
								{% endif %}

								<td width="50%" valign="top" style="padding: 10px;">
									<table cellpadding="10" cellspacing="0" style="border: 2px solid #babecb; border-radius: 16px; overflow: hidden;">
										<tr style="border-radius: 10px;">
											<td style="border-radius: 10px;">
												<img src="{{ image }}" style="width: 260px; height: 146px; border-radius: 8px; display: block;">
											</td>
										</tr>
									</table>
								</td>
								{% if loop.index0 is odd or loop.last %}
								</tr>
         {% endif %}
                           {% endfor %}
					</table>
               </div>
            </div>
         {% endif %}
	</body>
</html></div></body></html>
