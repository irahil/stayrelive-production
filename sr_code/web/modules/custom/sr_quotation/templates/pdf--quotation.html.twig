<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<title>Quotation</title>

		<style>
			/* =========================
   PDF SAFE BASE
========================= */
			body {
				margin: 0;
				padding: 0;
				font-family: Poppins, Arial, sans-serif;
				background-color: #f9f9f9;
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}

			.container {
				width: 100%;
				padding: 20px;
			}

			.row {
				width: 100%;
				clear: both;
			}

			.col-12 {
				width: 100%;
				display: block;
			}

			.mb-5 {
				margin-bottom: 30px;
			}

			.text-center {
				text-align: center;
			}


			.title-container {
				width: 100%;
				background: #0b8d9f;
				display: table;
				padding: 0;
				margin: 0 0 20px;
			}
			
			/* =========================
   BORDER RADIUS
========================= */
			.quote-wrapper,
			.property-hero {
				border-radius: 16px;
			}

			/* =========================
   HERO IMAGE
========================= */
			.property-hero {
				width: 100%;
				height: auto;
				display: block;
			}

			/* =========================
   QUOTE CARD
========================= */
			.quote-wrapper {
				border: 2px solid #babecb;
				background: #ffffff;
				padding: 25px;
				margin-bottom: 30px;
				position: relative;
				color: #192452;
				page-break-inside: avoid;
			}

			/* =========================
   SECTION HEADING + ICON
========================= */
			/*.quote-wrapper h4 {
				font-family: "Merriweather", serif;
        font-size: 2.25rem;


        margin: 0;
        padding: 0;
        min-height: 60px;
        line-height: 60px;

        position: relative;
			}

			.quote-wrapper h4 img.h4-icon {
				position: absolute;
        left: 0;
        top: 0;
        width: 60px;
        height: 60px;
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}*/

			.quote-wrapper h2 .section-title {
				position: relative;
				margin: 0;
				line-height: 60px;
				font-weight: 200;
			}

			.quote-wrapper h4 .testing {
				padding-bottom: 100px;
			}

			.quote-wrapper .title-table .h6 {
				font-size: 40px;
				font-family: "Merriweather", serif;
				font-weight: normal;
				color: #192452;
				position: absolute;
			}

			table .title-table {
				padding-bottom: 100px;
				margin-bottom: 30px;
			}

			/* ===== PDF SAFE TWO COLUMN LAYOUT ===== */
			.pdf-table {
				width: 100%;
				border-collapse: collapse;
				margin-top: 20px;
			}

			.pdf-table td {
				width: 50%;
				vertical-align: top;
				padding-bottom: 16px;
			}

			.pdf-label {
				color: #0B8D9F;
				font-weight: 600;
				display: block;
				margin-bottom: 4px;
				font-weight: bold;
			}

			.pdf-value {
				color: #192452;
			}

			/* =========================
   LIST COLUMNS (PDF SAFE)
========================= */
			.list-columns {
				column-count: 2;
				column-gap: 40px;
				padding-left: 0;
				list-style: none;
			}

			.list-columns li {
				break-inside: avoid;
				padding-bottom: 12px;
			}

			.list-columns li span {
				color: #0B8D9F;
				font-weight: bold;
				display: inline-block;
				min-width: 160px;
			}

			/* =========================
   PROPERTY IMAGES
========================= */
			.property-images img {
				width: 30%;
				margin: 10px;
				display: inline-block;
				vertical-align: top;
				border-radius: 10px;
			}
		</style>
	</head>

	<body>

		<div class="container">
			<div class="title-container">
				<h2 class="main-title">Quotation</h2>
			</div>

			<img src="https://static.plumcache.com/listings/d145409d-84c1-4e73-aabf-1d040aeb7059/59c76128-65de-407a-9d2f-2b91d0decef0..jpeg" class="property-hero" alt="Hero Image">
		</div>

		<div class="container">
			<div class="row">
				<div class="col-12">
					<h2 class="main-title" style="background: #0b8d9f; font-weight: normal; color: #192452; padding: 30px 20px; margin: 0; font-family: 'Merriweather', serif; font-size: 45px; text-align: center;">Booking Details</h2>
				</div>
			</div>
			<!-- BOOKING DETAILS -->
			<div
				class="quote-wrapper">
				{# <h2 class="section-title">
													<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-booking.png">
													<span class="title-text">Booking Information</span>
												</h2> #}

				<table class="title-table">

					<tr>
						<td rowspan="3">
							<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-bespoke.png">

						</td>
						<td></td>
						<td></td>
					</tr>

					<tr>
						<td rowspan="3">

							<h6 class="title-text" style="font-size: 25px; color: #192452; font-family: 'Merriweather', serif; font-weight: normal;">Booking Information</h6>

						</td>
						<td></td>
					</tr>

					<tr>
						<td rowspan=""></td>
						<td></td>

					</tr>
					<tr>
						<td rowspan=""></td>

					</tr>


				</table>

				<table class="pdf-table">
					<tr>
						<td>
							<span class="pdf-label">Booker Name:</span>
							<br>
							<span class="pdf-value">{{ data.booker_name|upper }}</span>
						</td>
						<td>
							<span class="pdf-label">Check-in Time:</span>
							<br>
							<span class="pdf-value">{{ data.checkin_time }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Travel Partner / Corporate:</span>
							<br>
							<span class="pdf-value">{{ data.travel_partner }}</span>
						</td>
						<td>
							<span class="pdf-label">Check-out Time:</span>
							<br>
							<span class="pdf-value">{{ data.checkout_time }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Check-in Date:</span>
							<br>
							<span class="pdf-value">{{ data.checkin_date }}</span>
						</td>
						<td>
							<span class="pdf-label">Number of Nights:</span>
							<br>
							<span class="pdf-value">{{ data.nights }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Check-out Date:</span>
							<br>
							<span class="pdf-value">{{ data.checkout_date }}</span>
						</td>
						<td></td>
					</tr>
				</table>
			</div>

			<!-- PROPERTY INFORMATION -->
			<div
				class="quote-wrapper">
				{# <h4>
																	<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-bespoke.png">
																	<span class="testing">
																		<span class="title-text">Property Information</span>
																		<span class="">cskbjclashb</span>
																	</span>
																</h4> #}

				<table class="title-table">

					<tr>
						<td rowspan="3">
							<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-bespoke.png">

						</td>
						<td></td>
						<td></td>
					</tr>

					<tr>
						<td rowspan="3">

							<h6 class="title-text" style="font-size: 25px; color: #192452; font-family: 'Merriweather', serif; font-weight: normal;">Property Information</h6>

						</td>
						<td></td>
					</tr>

					<tr>
						<td rowspan="3"></td>
						<td></td>

					</tr>


				</table>
				<table class="pdf-table">
					<tr>
						<td>
							<span class="pdf-label">Unit Type:</span>
							<br>
							<span class="pdf-value">{{ data.unit_type }}</span>
						</td>
						<td>
							<span class="pdf-label">Room Type:</span>
							<br>
							<span class="pdf-value">{{ data.room_type }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Room Category:</span>
							<br>
							<span class="pdf-value">{{ data.room_category }}</span>
						</td>
						<td>
							<span class="pdf-label">Bathrooms:</span>
							<br>
							<span class="pdf-value">{{ data.bathrooms }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Apartment Size:</span>
							<br>
							<span class="pdf-value">{{ data.apartment_size }}</span>
						</td>
						<td>
							<span class="pdf-label">Adults:</span>
							<br>
							<span class="pdf-value">{{ data.adults }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Kids:</span>
							<br>
							<span class="pdf-value">{{ data.kids }}</span>
						</td>
						<td>
							<span class="pdf-label">Location:</span>
							<br>
							<span class="pdf-value">{{ data.location }}</span>
						</td>
					</tr>

					<tr>
						<td>
							<span class="pdf-label">Distance:</span>
							<br>
							<span class="pdf-value">{{ data.distance }}</span>
						</td>
						<td>
							<span class="pdf-label">Map Link:</span>
							<br>
							<span class="pdf-value">{{ data.map_link }}</span>
						</td>
					</tr>
				</table>
			</div>

		</div>

		<!-- PRICING -->
		<div
			class="quote-wrapper">
			{# <h4>
										<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-safety.png">
										<span class="title-text">Pricing & Financials</span>
						
									</h4> #}

			<table class="title-table">

				<tr>
					<td rowspan="3">
						<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-bespoke.png">

					</td>
					<td></td>
					<td></td>
				</tr>

				<tr>
					<td rowspan="3">

						<h6 class="title-text" style="font-size: 25px; color: #192452; font-family: 'Merriweather', serif; font-weight: normal;">Pricing & Financials</h6>

					</td>
					<td></td>
				</tr>

				<tr>
					<td rowspan="3"></td>
					<td></td>

				</tr>


			</table>
			<table class="pdf-table">
				<tr>
					<td>
						<span class="pdf-label">Quote:</span>
						<br>
						<span class="pdf-value">{{ data.quote }}</span>
					</td>
					<td>
						<span class="pdf-label">Taxes:</span>
						<br>
						<span class="pdf-value">{{ data.taxes }}</span>
					</td>
				</tr>

				<tr>
					<td>
						<span class="pdf-label">FX Rate:</span>
						<br>
						<span class="pdf-value">{{ data.fx_rate }}</span>
					</td>
					<td>
						<span class="pdf-label">Currency:</span>
						<br>
						<span class="pdf-value">{{ data.currency }}</span>
					</td>
				</tr>

				<tr>
					<td>
						<span class="pdf-label">Add-ons:</span>
						<br>
						<span class="pdf-value">{{ data.addon_prices ?: 'N/A' }}</span>
					</td>
					<td></td>
				</tr>
			</table>
		</div>

		<!-- POLICIES -->
		<div
			class="quote-wrapper">
			{# <h4>
										<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-hospitality.png">
						
										<span class="title-text">Policies</span>
						
									</h4> #}

			<table class="title-table">

				<tr>
					<td rowspan="3">
						<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-bespoke.png">

					</td>
					<td></td>
					<td></td>
				</tr>

				<tr>
					<td rowspan="3">

						<h6 class="title-text" style="font-size: 25px; color: #192452; font-family: 'Merriweather', serif; font-weight: normal;">Policies</h6>

					</td>
					<td></td>
				</tr>

				<tr>
					<td rowspan="3"></td>
					<td></td>

				</tr>


			</table>

			<table class="pdf-table">
				<tr>
					<td>
						<span class="pdf-label">Cancellation Policy:</span>
						<br>
						<span class="pdf-value">{{ data.cancellation_policy }}</span>
					</td>
					<td>
						<span class="pdf-label">Status:</span>
						<br>
						<span class="pdf-value">{{ data.confirmation_status }}</span>
					</td>
				</tr>

				<tr>
					<td>
						<span class="pdf-label">Rules:</span>
						<br>
						<span class="pdf-value">{{ data.rules }}</span>
					</td>
					<td>
						<span class="pdf-label">Supplier Reference:</span>
						<br>
						<span class="pdf-value">{{ data.supplier_reference }}</span>
					</td>
				</tr>

				<tr>
					<td colspan="2">
						<span class="pdf-label">Notes:</span>
						<br>
						<span class="pdf-value">{{ data.note }}</span>
					</td>
				</tr>
			</table>
		</div>

		<!-- PROPERTY IMAGES -->
		{% if image_urls %}
			<div class="quote-wrapper">
				<h4>
					<img class="h4-icon" src="https://uat.stayrelive.com/sites/default/files/inline-images/icon-hospitality.png">
					Property Images
				</h4>

				<div class="property-images">
					{% for image_url in image_urls %}
						<img src="{{ image_url }}">
					{% endfor %}
					{% for image_url in location_screenshot_urls %}
						<img src="{{ image_url }}">
					{% endfor %}
				</div>
			</div>
		{% endif %}
	</body>
</html></div></body></html>
