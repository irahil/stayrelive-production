<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SilverDoor - Apartment Options</title>
    <style>
        /* Reset and base styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }
        
        body {
            font-family: 'Georgia', serif;
            background-color: white;
            color: #2c3e50;
            width: 210mm;
            margin: 0 auto;
            padding: 0;
            line-height: 1.4;
        }

        .page {
            width: 210mm;
            min-height: 297mm;
            padding: 20mm;
            background: white;
            page-break-after: always;
        }

        .logo {
            text-align: center;
            font-size: 42px;
            font-weight: 300;
            color: #34495e;
            margin-bottom: 30px;
            letter-spacing: 3px;
        }

        .header-title {
            font-size: 20px;
            color: #34495e;
            margin-bottom: 30px;
            font-weight: 400;
            letter-spacing: 1px;
        }

        .section-title {
            font-size: 14px;
            color: #34495e;
            margin-bottom: 15px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        /* Main layout table */
        .main-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

        /* Enquiry table styling */
        .enquiry-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        .enquiry-table .combined-cell {
            background-color: #E7ECEB;
            padding: 10px 15px;
            font-size: 12px;
            color: #34495e;
            border-radius: 4px 0 0 4px;
            vertical-align: middle;
            width: 45%;
        }

        .enquiry-table .icon-container {
            width: 35px;
            height: 35px;
            background-color: red;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            margin-right: 12px;
        }

        {# .enquiry-table .icon-container svg {
            width: 18px;
            height: 18px;
            fill: white;
        } #}

        .enquiry-table .value-cell {
            padding: 10px 15px;
            font-size: 12px;
            color: #34495e;
            background-color: #fff;
            border-radius: 0 4px 4px 0;
            border: 1.5px solid #E7ECEB;
            vertical-align: middle;
            width: 55%;
        }

        /* Contact section styling */
        .contact-box {
            background-color: #E7ECEB;
            padding: 20px;
            border-radius: 5px;
            margin-bottom: 20px;
        }

        .contact-table {
            width: 100%;
            border-collapse: collapse;
        }

        .contact-photo-cell {
            width: 80px;
            vertical-align: top;
            padding-right: 15px;
        }

        .contact-photo {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            overflow: hidden;
            background-color: #d5d5d5;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 12px;
        }

        .contact-info h3 {
            font-size: 16px;
            color: #34495e;
            margin-bottom: 4px;
            margin-top: 0;
        }

        .contact-info p {
            font-size: 11px;
            color: #34495e;
            margin-bottom: 2px;
        }

        .contact-note {
            font-size: 11px;
            line-height: 1.5;
            color: #34495e;
            margin-top: 12px;
        }

        .contact-note a {
            color: #5dade2;
            text-decoration: none;
        }

        /* Comments section */
        .comments-box {
            background-color: #E7ECEB;
            padding: 15px;
            border-radius: 5px;
            font-size: 12px;
            color: #34495e;
            min-height: 80px;
        }

        /* Apartment options section */
        .options-section {
            margin-top: 30px;
        }

        .apartment-card {
            border: 1px solid #d5d5d5;
            border-radius: 5px;
            padding: 20px;
            margin-bottom: 20px;
            page-break-inside: avoid;
        }

        .apartment-table {
            width: 100%;
            border-collapse: collapse;
        }

        .apartment-image-cell {
            width: 350px;
            vertical-align: top;
            padding-right: 20px;
        }

        .apartment-image {
            width: 100%;
            height: 220px;
            border-radius: 5px;
            overflow: hidden;
            background-color: #f5f5f5;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #888;
        }

        .apartment-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .apartment-details h3 {
            font-size: 16px;
            color: #34495e;
            margin-bottom: 8px;
            margin-top: 0;
        }

        .apartment-address {
            font-size: 13px;
            color: #34495e;
            margin-bottom: 15px;
            font-weight: 400;
        }

        .details-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

        .details-table .label-cell {
            width: 160px;
            color: #34495e;
            font-weight: 500;
            padding: 2px 0;
            vertical-align: top;
        }

        .details-table .value-cell {
            color: #34495e;
            padding: 2px 0;
            vertical-align: top;
        }

        .sustainability-row {
            margin-top: 12px;
            display: flex;
            align-items: center;
        }

        .eco-icon {
            width: 25px;
            height: 25px;
            background-color: #a8d5ba;
            border-radius: 50%;
            display: inline-block;
            vertical-align: middle;
            margin-right: 8px;
        }
        {# .icon-container {
    background-color: #dcdcdc;
    border-radius: 50rem;
} #}

        /* Print-specific styles */
        @media print {
            body {
                width: 100%;
                margin: 0;
                padding: 0;
            }

            .page {
                margin: 0;
                padding: 20mm;
                box-shadow: none;
            }

            .apartment-card {
                page-break-inside: avoid;
            }
            
            /* Force background colors in print */
            .enquiry-table .combined-cell,
            .contact-box,
            .comments-box {
                background-color: #E7ECEB !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            
            .enquiry-table .icon-container {
                background-color: #dcdcdc !important;
                -webkit-print-color-adjust: exact;
                border-radius: 50% !important;
                print-color-adjust: exact;
            }

            .contact-photo {
                background-color: #d5d5d5 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .eco-icon {
                background-color: #a8d5ba !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
