<?php 

function sr_quotation_theme($existing, $type, $theme, $path) {
  $module_handler = \Drupal::service('extension.list.module');
  $module_path = $module_handler->getPath('sr_quotation');
  return [
    'quotation_form' => [
      'render element' => 'form',
      'template' => 'quotation-form',
      'library' => [
        'sr_quotation/quotation-form',
      ],
    ],
    'quotation_dashboard' => [
      'variables' => [
        'quotations' => [],
        'filters' => [],
        'add_link' => NULL,
      ],
      'template' => 'quotation-dashboard',
    ],
    'pdf__quotation' => [
      'variables' => [
        'data' => [],
        'image_urls' => [],
        'location_screenshot_urls' => [],
      ],
      'template' => 'pdf--quotation',
      'path' => $module_path . '/templates',
    ],
    // 🆕 HTML PREVIEW TEMPLATE
    'quotation_preview' => [
      'variables' => [
        'data' => [],
        'image_urls' => [],
        'location_screenshot_urls' => [],
      ],
      'template' => 'quotation-preview',
      'path' => $module_path . '/templates',
    ],
  ];
}