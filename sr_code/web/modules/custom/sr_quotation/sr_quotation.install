<?php

/**
 * @file
 * Install, update and uninstall functions for the sr_quotation module.
 */

/**
 * Implements hook_schema().
 */
function sr_quotation_schema() {
  $schema['sr_quotation'] = [
    'description' => 'Stores quotation form submissions.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'uid' => ['type' => 'int','not null' => FALSE,'default' => 0,],
      'booker_id' => ['type' => 'varchar', 'length' => 100],
      'booker_name' => ['type' => 'varchar', 'length' => 255],
      'travel_partner' => ['type' => 'varchar', 'length' => 255],
      'checkin_date' => ['type' => 'varchar', 'length' => 50],
      'checkout_date' => ['type' => 'varchar', 'length' => 50],
      'checkin_time' => ['type' => 'varchar', 'length' => 50],
      'checkout_time' => ['type' => 'varchar', 'length' => 50],
      'nights' => ['type' => 'varchar', 'length' => 10],
      'unit_type' => ['type' => 'varchar', 'length' => 100],
      'apartment_size' => ['type' => 'varchar', 'length' => 50],
      'room_type' => ['type' => 'varchar', 'length' => 100],
      'room_category' => ['type' => 'varchar', 'length' => 255],
      'bathrooms' => ['type' => 'varchar', 'length' => 10],
      'adults' => ['type' => 'varchar', 'length' => 10],
      'kids' => ['type' => 'varchar', 'length' => 10],
      'location' => ['type' => 'varchar', 'length' => 255],
      'distance' => ['type' => 'varchar', 'length' => 255],
      'map_link' => ['type' => 'varchar', 'length' => 255],
      'description' => ['type' => 'text', 'size' => 'big'],
      'location_screenshot' => ['type' => 'text', 'size' => 'big'],
      'currency' => ['type' => 'varchar', 'length' => 10],
      'quote' => ['type' => 'varchar', 'length' => 255],
      'taxes' => ['type' => 'varchar', 'length' => 100],
      'fx_rate' => ['type' => 'varchar', 'length' => 100],
      'addon_prices' => ['type' => 'varchar', 'length' => 300],
      'amenities' => ['type' => 'text', 'size' => 'big'],
      'cancellation_policy' => ['type' => 'text', 'size' => 'big'],
      'images' => ['type' => 'text', 'size' => 'big'],
      'rules' => ['type' => 'text', 'size' => 'big'],
      'note' => ['type' => 'text', 'size' => 'big'],
      'supplier_reference' => ['type' => 'varchar','length' => 100],
      'confirmation_status' => ['type' => 'varchar','length' => 50],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => REQUEST_TIME,
      ],
    ],
    'primary key' => ['id'],
  ];

  return $schema;
}
