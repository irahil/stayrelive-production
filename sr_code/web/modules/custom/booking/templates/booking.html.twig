{#
/**
 * @file
 * Default theme implementation to present a booking entity.
 *
 * This template is used when viewing a canonical booking page,
 *
 * Available variables:
 * - content: A list of content items. Use 'content' to print all content, or
 *   print a subset such as 'content.label'.
 * - attributes: HTML attributes for the container element.
 *
 * @see template_preprocess_booking()
 */
#}
<div class="container">
<div class="row">
<div class="col-8">
<article{{ attributes }}>
<div class="booking-hero 12e">
<h1>Review your booking</h1>
</div>
<div class="booking-info">
<h1>Hotel Info</h1>
</div>
  {% if view_mode != 'full' %}
    {{ title_prefix }}
    {{ title_suffix }}
  {% endif %}
  {% if content %}
    {{- content -}}
  {% endif %}
</article>
<div class="col-4">
</div<
</div>
</div>
</div>
