/**
 * Implements hook_form_FORM_ID_alter().
 */
function sr_form_user_register_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id)
{
  $country_code = \Drupal::service('session')->get('country_code', 'default');
  \Drupal::logger('sr_user_register')->notice('Country code used: ' . $country_code);

  $form['field_phone_code']['widget']['#options']['_none'] = "Select";
  $form['actions']['submit']['#value'] = 'Register';

  $form['country_code'] = [
    '#type' => 'hidden',
    '#title' => "Country Code",
    '#default_value' => $country_code,
  ];

  // Get the current route name
  $current_route_name = \Drupal::routeMatch()->getRouteName();

  if (in_array(strtolower($country_code), ['ae', 'cz']) || $current_route_name == "agent_registration.register") {
    $form['field_is_agent']['widget']['value']['#default_value'] = 1;
  } else {
    $fields_to_hide = [
      'field_agency_name',
      'field_agent_contact_number',
      'field_address',
      'field_state',
      'field_iata_status',
      'field_company_registration_no',
      'field_pin_code',
      'field_registered_consultant_name',
      'field_registered_consultant_emai',
      'field_registered_consultant_cont',
      'field_registered_consultant_mobi',
      'field_finance_manager_name',
      'field_finance_manager_contact',
      'field_finance_manager_email',
      'field_agent_email_address',
      'field_company_registration_certi',
      'field_company_url',
      'field_branch_name',
    ];
    foreach ($fields_to_hide as $field) {
      if (isset($form[$field])) {
        $form[$field]['#access'] = FALSE;
      }
    }
  }
  $form['field_is_agent']['#attributes']['class'][] = 'hidden';
  $form['#cache']['contexts'][] = 'session';
}

function sr_form_user_login_form_alter(&$form, &$form_state, $form_id)
{
  $form['#submit'][] = 'sr_user_login_submit';
}

/**
 * Form submission handler for user_login_form().
 *
 * Redirects the user to the dashboard after logging in.
 */
function sr_user_login_submit(&$form, \Drupal\Core\Form\FormStateInterface $form_state)
{
  $url = Url::fromRoute('<front>', array())->toString();
  // Check if a destination was set, probably on an exception controller.
  // @see \Drupal\user\Form\UserLoginForm::submitForm()
  $request = \Drupal::service('request_stack')->getCurrentRequest();
  if (!$request->request->has('destination')) {
    \Drupal::messenger()->addStatus("Logged in successfully!\n");
    commonUtil::my_goto_t2($url);
  } else {
    $request->query->set('destination', $request->request->get('destination'));
  }
}

