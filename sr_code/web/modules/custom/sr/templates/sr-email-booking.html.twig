                                    </tr>
                                    <tr>
                                       <td><strong>Check In</strong></td>
                                       <td>{{ from_date }}</td>
                                    </tr>
                                    <tr>
                                       <td><strong>Check Out</strong></td>
                                       <td>{{ to_date }}</td>
                                    </tr>
                                    <tr>
                                       <td><strong>Price</strong></td>
                                       <td>{{ currency_code }} {{ price }} </td>
                                    </tr>
                                     <tr>
                                       <td><strong>Status</strong></td>
                                       <td>{{ status }}</td>
                                    </tr>
                                 </table>

                                    <p class="white-font">If you have any queries please reach out to us at book@stayrelive.com</p>
                                    <p class="white-font">Please click <a href='{{ property_url }}'>here</a> to view the property.
                                   <a href='https://stayrelive.com/property/booking/search'>Click here</a> to view your booking details.
                                 </p>
                              </div>
                           </td>
                        </tr>
                     </table>
                  </td>
               </tr>
            </table>
             <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin: auto;">
                <tr>
                    <td valign="middle" style="background-color: #1C234F;color:#fff" class="bg_black footer email-section">
                        <table>
                            <tr>
                                <td valign="top" width="45%" style="padding: 20px 30px;">
                                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                        <tr>
