                  </td>
               </tr>
               <tr>
                  <td valign="middle" class="hero" style="background-image: url(https://stayrelive.com/themes/srdesign/assets/images/home/hero.webp); background-size: cover; background-position: center center; height: 300px;">
                     <table>
                        <tr>
                           <td>
                              <div class="text" style="padding: 0 3em; text-align: center;">
                              </div>
                           </td>
                        </tr>
