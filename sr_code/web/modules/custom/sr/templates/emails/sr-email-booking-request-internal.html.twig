    <style type="text/css">
        /* For better mobile experience and general resets */
        body {
            margin: 0;
            padding: 0;
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
            font-family: 'Roboto', Arial, sans-serif;
        }

        table {
            border-collapse: collapse;
        }

        img {
            border: 0;
            height: auto;
            line-height: 100%;
            outline: none;
            text-decoration: none;
            -ms-interpolation-mode: bicubic;
        }

        a img {
            border: 0;
        }

        .apple-link a {
            color: #333333 !important;
            text-decoration: none !important;
        }

        .button {
            background-color: #007bff;
            /* Example blue color */
            color: #ffffff;
            padding: 12px 20px;
            text-decoration: none;
            border-radius: 5px;
            display: inline-block;
            /* Essential for padding on anchor tags */
        }
    </style>

<body style="margin: 0; padding: 0;">
    <center style="width: 100%;">
        <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse;">
            <tr>
                <td valign="top" style="padding: 0;">
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="650" style="border-collapse: collapse; background-color: #ffffff; margin: 0 auto;">
                        <tr>
                            <td style="padding: 0;">
                                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                    <tr>
                                        <td style="text-align: center; padding: 20px 0;">
                                            <a href="https://www.stayrelive.com" target="_blank" style="text-decoration: none;">
                                                <img src="https://stayrelive.com/sites/default/files/sr-logo.png" alt="CorpHousing Logo" width="auto" height="50" style="display: block; margin: 0 auto; border: 0;" />
                                            </a>
                                        </td>
                                    </tr>
                                </table>

                                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                                    <tr>
                                        <td style="padding: 0;">
                                            <img src="https://stayrelive.com/themes/srdesign/assets/images/home/hero-3.webp" alt="StayRelive Hero" width="650" height="300" style="display: block; border: 0; max-width: 100%; height: auto;" />
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 40px 30px; font-family: 'Roboto', Arial, sans-serif; font-size: 15px; line-height: 22px; color: #FFFFFF; background-color: #1590A0">
                                <p style="margin-bottom: 20px;">Dear Team, </p>

                                <p style="margin-bottom: 40px;">A new booking request has been received that requires processing and confirmation.</p>

                                <h3 style="margin-bottom: 12px;">Booking Details:</h3>

                                <p style="margin-bottom: 12px;">Booking ID: {{ booking_id }}</p>
                                <p style="margin-bottom: 12px;">Time Stamp: {{ "now"|date("jS F Y H:i") }}</p>
                                <p style="margin-bottom: 12px;">Property Name: {{ property_title }}</p>
                                <p style="margin-bottom: 12px;">Location: {{ town_city }}</p>
                                <p style="margin-bottom: 12px;">Number of Adults: {{ adults }}</p>
                                <p style="margin-bottom: 40px;">Number of Kids: {{ kids }}</p>

                                <h3 style="margin-bottom: 12px;">Contact Information:</h3>
                                <p style="margin-bottom: 12px;">Customer Name: {{ username }}</p>
                                <p style="margin-bottom: 12px;">
                                    Contact Email:
                                    <a href="mailto:{{ email }}" style="color: #FFFFFF; text-decoration: underline; font-weight: 500;">
                                        {{ email }}
                                    </a>
                                    
                                </p>
                                <p style="margin-bottom: 12px;">
                                    Contact Phone:
                                    <a href="tel:{{ phone_number }}" style="color: #FFFFFF; text-decoration: underline; font-weight: 500;">
                                        {{ phone_number }}
                                    </a>
                                </p>
                                <p style="margin-bottom: 30px;">Additional Information: {{ additional_information }}</p>
                                <p style="margin-bottom: 40px;">Thanks</p>

                                <p style="margin-bottom: 18px;">*This is an internal communication. All customer data should be handled according to our data
                                    protection and privacy policies*</p>
                            </td>
                        </tr>

                        <tr>
                            <td style="padding: 30px; background-color: #f2f2f2; text-align: center; color: #333; font-family: 'Roboto', Arial, sans-serif;">
                                <h2 style="margin-bottom: 20px; font-family: 'Roboto', Arial, sans-serif; font-size: 24px;">StayRelive</h2>

                                <div style="margin-bottom: 20px;">
                                    <a href="https://www.instagram.com/stayrelive" target="_blank" style="margin: 0 10px; display: inline-block;">
                                        <img src="https://cdn-icons-png.flaticon.com/512/15707/15707749.png" alt="Instagram" width="32" height="32" style="border-radius: 40%; border: 0;" />
                                    </a>
                                    <a href="https://www.linkedin.com/company/stayrelive/" target="_blank" style="margin: 0 10px; display: inline-block;">
                                        <img src="https://cdn-icons-png.flaticon.com/512/145/145807.png" alt="LinkedIn" width="32" height="32" style="border-radius: 40%; border: 0;" />
                                    </a>
                                    <a href="https://www.facebook.com/StayRelive/" target="_blank" style="margin: 0 10px; display: inline-block;">
                                        <img src="https://cdn-icons-png.flaticon.com/512/15047/15047435.png" alt="Facebook" width="32" height="32" style="border-radius: 40%; border: 0;" />
                                    </a>
                                    <a href="https://wa.me/916362730626" target="_blank" style="margin: 0 10px; display: inline-block;">
                                        <img src="https://cdn-icons-png.flaticon.com/512/15707/15707820.png" alt="WhatsApp" width="32" height="32" style="border-radius: 40%; border: 0;" />
                                    </a>
                                    <a href="https://x.com/StayRelive" target="_blank" style="margin: 0 10px; display: inline-block;">
                                        <img src="https://logowik.com/content/uploads/images/twitter-x5265.logowik.com.webp" alt="Twitter" width="32" height="32" style="border-radius: 50%; border: 0;" />
                                    </a>
                                </div>
                                <hr style="margin: 30px auto 15px; border: none; border-top: 1px solid #ccc; width: 80%;" />

                                <p style="margin: 0; font-size: 13px; color: #777;">&copy; 2026 StayRelive. All rights reserved.</p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </center>
</body>