<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title>New Customer Query — Internal</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;600&display=swap" rel="stylesheet">
  <style>
    @media (prefers-color-scheme: dark) { .dark-bg { background-color: #ffffff !important; } }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#ffffff; font-family:'Roboto', Arial, sans-serif;">
  <center style="width:100%; background-color:#ffffff;" class="dark-bg">
    <table width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center" style="padding:40px 0;">
          <table width="600" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #eeeeee;" class="dark-bg">

            <!-- LOGO -->
            <tr>
              <td align="center" style="padding:25px;">
                <img src="https://stayrelive.com/sites/default/files/sr-logo.png" height="50" alt="StayRelive Logo" style="display:block;">
              </td>
            </tr>

            <!-- HERO IMAGE -->
            <tr>
              <td>
                <img src="https://stayrelive.com/themes/srdesign/assets/images/home/hero-3.webp" width="600" alt="StayRelive" style="display:block; width:100%; height:auto;">
              </td>
            </tr>

            <!-- MAIN CONTENT -->
            <tr>
              <td style="padding:40px 30px; background:#f9f9f9; color:#000000; font-size:16px; line-height:24px;">

                <p style="margin:0 0 16px;">Dear <strong>Team</strong>,</p>
                <p style="margin:0 0 24px;">A new customer query has been received that requires your attention and processing.</p>

                <p style="margin:0 0 12px; font-weight:600; font-size:17px;">Query Details:</p>

                <!-- Query details box -->
                <div style="border-left:4px solid #D6E4FF; background:#ffffff; padding:15px 20px; margin:0 0 24px;">
                  <p style="margin:0 0 8px;"><strong>Date &amp; Time Received:</strong> {{ date_time }}</p>
                  <p style="margin:0 0 8px;"><strong>First Name:</strong> {{ first_name }}</p>
                  <p style="margin:0 0 8px;"><strong>Last Name:</strong> {{ last_name }}</p>
                  <p style="margin:0 0 8px;"><strong>Email:</strong> <a href="mailto:{{ email }}" style="color:#1D1D1D; text-decoration:none; font-weight:600;">{{ email }}</a></p>
                  <p style="margin:0 0 8px;"><strong>Booking ID:</strong> {{ booking_id }}</p>
                  <p style="margin:0;"><strong>Additional Information:</strong> {{ message_text }}</p>
                </div>

                <hr style="border:none; border-top:1px solid #e0e0e0; margin:30px 0;">

                <p style="margin:0; font-size:13px; color:#777777;">*This is an internal communication. Please ensure all customer data is handled according to our data protection policies.*</p>

              </td>
            </tr>

            <!-- SOCIAL FOOTER -->
            <tr>
              <td align="center" style="padding:40px 30px; background:#f9f9f9; text-align:center;">
                <h2 style="margin:0 0 20px; font-size:22px; color:#000000;">StayRelive</h2>
                <table align="center" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="padding:0 8px;"><a href="https://www.instagram.com/stayrelive" target="_blank"><img src="https://cdn-icons-png.flaticon.com/512/1077/1077042.png" width="28" height="28" alt="Instagram"></a></td>
                    <td style="padding:0 8px;"><a href="https://www.linkedin.com/company/stayrelive/" target="_blank"><img src="https://cdn-icons-png.flaticon.com/512/13266/13266142.png" width="28" height="28" alt="LinkedIn"></a></td>
                    <td style="padding:0 8px;"><a href="https://www.facebook.com/StayRelive/" target="_blank"><img src="https://cdn-icons-png.flaticon.com/512/13266/13266170.png" width="28" height="28" alt="Facebook"></a></td>
                    <td style="padding:0 8px;"><a href="https://wa.me/916362730626" target="_blank"><img src="https://cdn-icons-png.flaticon.com/512/466/466966.png" width="28" height="28" alt="WhatsApp"></a></td>
                    <td style="padding:0 8px;"><a href="https://x.com/StayRelive" target="_blank"><img src="https://cdn-icons-png.flaticon.com/512/14417/14417460.png" width="28" height="28" alt="Twitter/X"></a></td>
                  </tr>
                </table>
                <p style="margin:25px 0 0; font-size:12px; color:#999999;">&copy; {{ "now"|date("Y") }} StayRelive. All rights reserved.</p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </center>
</body>
</html>
