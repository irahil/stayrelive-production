<section class="home-hero p-0">
   <div class="container-fluid">
      <div class="row hero-wrapper">
         <div class="col-12 px-0">
            <div class="home-hero-image position-relative">
               <img src="{{ base_path }}themes/srdesign/assets/images/home/hero-1.avif" alt="Find Apartments wherever you travel">
               <div class="hero-copy position-absolute">
                  <h1>Find Apartments wherever you travel</h1>
                  <p>Discover your ideal apartment anytime, anywhere!</p>
               </div>
            </div>
         </div>
      </div>
      <div class="search-property position-relative" id="searchComponent2"  style="z-index:1000; display:flex; justify-content:center; align-items:center" >
         <div class="" id="searchComponent">
            <div class="search-container row d-flex justify-content-center">
               <div class="search-city search-city-default-check">
                  <span class="icon-city">
                  <i class="fa-solid fa-building-user"></i></span>
                  {{ form.form_build_id }}
                  {{ form.form_token }}
                  {{ form.form_id }}
                  {{ form.filter.town_city }}
               </div>
               <div class="search-date">
                  <span class="icon-checkin"><i class="fa-solid fa-calendar-days"></i></span>
                  {{ form.filter.date }}
                  <span class="icon-checkout"><i class="fa-solid fa-magnifying-glass-location"></i></span>
               </div>
               <div class="add-adults">
                  <a heaf="#" class="occupants-minus" onclick="fn_occupants('adult', '-');return false;">-</a>
                  <span class="icon-adult"><i class="fa-solid fa-person"></i></span>
                  {{ form.filter.occupants.adult }}
                  <a heaf="#" class="occupants-plus" onclick="fn_occupants('adult', '+');return false;">+</a>
               </div>
               <div class="add-kids">
                  <a heaf="#" class="occupants-minus" onclick="fn_occupants('kid', '-');return false;">-</a>
                  <span class="icon-kids"><i class="fa-solid fa-child"></i></span>
                  {{ form.filter.occupants.kid }}
                  <a heaf="#" class="occupants-plus" onclick="fn_occupants('kid', '+');return false;">+</a>
               </div>
               <div class="search-submit">
                  {{ form.filter.actions.submit }}
                  </span>
               </div>
            </div>
         </div>
      </div>
   </div>
</section>
