{#
  Custom template for the Property Form.
  Assumes hook_theme() defines template 'property_form'.
#}

<div class="property-form-wrapper">

<div class="form-back-link">
  <div class="back-link-button">
    <a>{{ form.back_link }}</a>
  </div>
</div>
<div style="clear: both;"></div>

<div class="property-basic-info">
  <fieldset>
  <legend><strong>{{ form.property_basic_info['#title'] }}</strong></legend>
    
    {% if form.property_basic_info.published is defined %}
    <div class="published">
    {{ form.property_basic_info.published }}
    </div>

    {% endif %}
    {% if form.property_basic_info.markup_type_wrapper is defined %}  
      <div class="markup_type_wrapper">{{ form.property_basic_info.markup_type_wrapper }}</div>
    {% endif %}
    
    {{ form.property_basic_info.property_type }}
    {{ form.property_basic_info.room_types }}
    <div class="name-wrapper">
    {{ form.property_basic_info.property_name_age_wrapper }}
    </div>
    <div class="description">
    {{ form.property_basic_info.property_description }}
    </div>
    
    <div class="lat-lng-row">
    {{ form.property_basic_info.lat_lng_row }}
    </div>

    <div class="address">
    {{ form.property_basic_info.address }}
    </div>
    
    <div class="country-row">
    {{ form.property_basic_info.location_row_1 }}
    </div>
    

    <div class="location-row">
    {{ form.property_basic_info.location_row_2 }}
    </div>
    
  </fieldset>
  </div>

  <div class="property-details">
  <fieldset>
    <legend><strong>{{ form.property_details['#title'] }}</strong></legend>
    {{ form.property_details.primary_media }}

    <div class="property-photos">
    {{ form.property_details.media }}
    </div>
    
    {{ form.property_details.on_site_staffing }}

    <div class="amenities">
    {{ form.property_details.property_amenities }}
    </div>
    
    {{ form.property_details.food_beverages }}
    {{ form.property_details.breakfast_provides }}
    {{ form.property_details.breakfast_price }}
  </fieldset>
  </div>

  <fieldset>
    <legend><strong>{{ form.host_details['#title'] }}</strong></legend>
    {{ form.host_details.hosting_type }}
    {{ form.host_details.owner_contact_wrapper}}
    {{ form.host_details.owner_contact_mobile }}
    {{ form.host_details.owner_contact_landline }}
    {{ form.host_details.designation }}
  </fieldset>

   <fieldset>
    <legend><strong>{{ form.policy_info['#title'] }}</strong></legend>
    {{ form.policy_info.cancellation_info }}
    {{ form.policy_info.early_checkout }}
    {{ form.policy_info.security_deposit_wrapper }}
  </fieldset>



  <fieldset>
    <legend><strong>{{ form.finance_details['#title'] }}</strong></legend>
    {{ form.finance_details.billing_name }}

    <fieldset>
      <legend><strong>{{ form.finance_details.bank_details['#title'] }}</strong></legend>
      {{ form.finance_details.bank_details.bank_account_wrapper }}
      {{ form.finance_details.bank_details.bank_ifsc_wrapper}}
      {{ form.finance_details.bank_details.bank_gst_wrapper }}
    </fieldset>
  </fieldset>

  <div class="form-actions">
    {{ form.form_build_id }}
    {{ form.form_token }}
    {{ form.form_id }}
    {{ form.actions.submit }}
    {{ form.submit }}
  </div>

</div?>
