<div class="map-preview-card">
  <div class="map-preview-bg" data-map-open role="button" aria-label="Open map">
    <img
      src="{{ file_url(directory ~ '/assets/images/property/property_map_image.jpeg') }}"
      alt="Property locations map preview"
      class="property-map-preview-img"
    />
    <button type="button" class="show-map-btn show-map-btn--overlay" data-map-open aria-label="{{ 'Show on map'|t }}">
      <span class="show-map-btn__icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="currentColor"/>
        </svg>
      </span>
      {{ 'Show on map'|t }}
    </button>
  </div>
</div>

{# ---- MAP MODAL ---- #}
<div class="map-modal" data-map-modal hidden>
  <div class="map-modal-overlay" data-map-close></div>

  <div class="map-modal-wrapper">
    <button class="map-modal-close" data-map-close aria-label="Close map">✕</button>

    {# Two-column layout: map left, filters right #}
    <div class="map-modal-inner">
      <div id="property-map" class="property-map-full"></div>

      {# Filter sidebar — JS clones the page filters into #map-filter-body #}
      <div class="map-filter-sidebar" id="map-filter-sidebar">
        <div class="map-filter-sidebar__header">
          <span class="map-filter-sidebar__title">Filters</span>
          <button class="map-filter-sidebar__clear" id="map-filter-clear" type="button">Clear all</button>
        </div>
        <div class="map-filter-sidebar__body" id="map-filter-body">
          {# Filters cloned here by property-map.js from .property-filter-form #}
          <div class="map-filter-loading">Loading filters…</div>
        </div>
        <div class="map-filter-apply-wrap">
          <button class="map-filter-apply" id="map-filter-apply" type="button">Apply Filters</button>
        </div>
      </div>
    </div>

  </div>
</div>

{{ attach_library('srdesign/leaflet') }}
{{ attach_library('srdesign/property_map') }}
