{#
/**
 * @file
 * Theme override for a views exposed form.
 *
 * Available variables:
 * - form: A render element representing the form.
 *
 * @see template_preprocess_views_exposed_form()
 */
#}
{% if q is not empty %}
  {#
    This ensures that, if clean URLs are off, the 'q' is added first,
    as a hidden form element, so that it shows up first in the POST URL.
  #}
{{ q }}
{% endif %}

<form{{ attributes.addClass('property-filter-form') }}>

  <div class="filter-wrapper">

  {# Area Name #}
    <div class="filter-block">
      {{ form.field_area_name_value }}
    </div>

    {# City #}
    <div class="filter-block">
      {{ form.field_city_target_id }}
    </div>

    {# Property Type #}
    <div class="filter-block">
      {{ form.field_property_type_target_id }}
    </div>

    

    {# Amenities #}
    <div class="filter-block">
      {{ form.field_amenities_target_id }}
    </div>

    <div class="filter-actions">
      {{ form.actions.submit }}
    </div>

  </div>

 {{ form|without(
  'field_city_target_id',
  'field_property_type_target_id',
  'field_amenities_target_id',
  'field_area_name_value',
  'actions'
) }}

</form>