<!-- ================= ROLE / WHY GCC ================= -->
<section class="role-section">
	<div class="role-container">
		<span class="sub-heading">Why GCC</span>
		<h1>The Role of Corporate Housing in GCC Growth</h1>

		<nav class="gcc-tabs">
			<a class="tab-link active" data-tab="what-are-gccs">What are GCCs?</a>
			<a class="tab-link" data-tab="why-choose-india">Why GCC Choose India</a>
			<a class="tab-link" data-tab="gccs-in-india">GCCs in India</a>
		</nav>

		<!-- Tab Content: What are GCCs? -->
		<div class="tab-content active" id="tab-what-are-gccs">
			<p class="description">
				Global Capability Centers (GCCs), also known as Global In-House Centers (GICs), are offshore service units established by multinational companies (MNCs) to manage technology, operations, and business support functions from strategic global locations.
				<br>
				Today, GCCs are a vital part of global business strategies. Enterprises in technology, banking, manufacturing, retail, and healthcare leverage GCCs for cost optimization, operational flexibility, and digital transformation. By building GCCs, businesses enhance efficiency, agility, and customer experience while ensuring global presence and consistency.
			</p>

			<div class="stats-grid">
				<div class="stat-item">
					<span class="stat-number">1580+</span>
					<span class="stat-label">GCCs In
						<br>
						India</span>
				</div>
				<div class="stat-item">
					<span class="stat-number">1.66M+</span>
					<span class="stat-label">Professionals
						<br>
						Employed</span>
				</div>
				<div class="stat-item">
					<span class="stat-number">$46B</span>
					<span class="stat-label">Contribution To
						<br>
						Exports</span>
				</div>
			</div>
		</div>

		<!-- Tab Content: Why GCC Choose India -->
		<div class="tab-content" id="tab-why-choose-india">
			<p class="description">
				India has become the preferred destination for Global Capability Centers due to its large pool of skilled talent, cost-effective operations, robust infrastructure, and favorable business environment. The country offers world-class technology capabilities, English-speaking workforce, and a strong culture of innovation that aligns perfectly with global business needs.
			</p>

			<div class="stats-grid">
				<div class="stat-item">
					<span class="stat-number">1.66M+</span>
					<span class="stat-label">Professionals Employed</span>
				</div>
				<div class="stat-item">
					<span class="stat-number">$46B</span>
					<span class="stat-label">Contribution To Exports</span>
				</div>
				<div class="stat-item">
					<span class="stat-number">1580+</span>
					<span class="stat-label">GCCs In India</span>
				</div>
			</div>
		</div>

		<!-- Tab Content: GCCs in India -->
		<div class="tab-content" id="tab-gccs-in-india">
			<p class="description">
				GCCs in India have experienced exponential growth, establishing centers across major metropolitan cities including Bangalore, Mumbai, Hyderabad, Pune, Chennai, and Delhi-NCR. These centers serve as strategic hubs for innovation, digital transformation, and operational excellence, contributing significantly to India's economy and positioning the country as a global technology and business services leader.
			</p>

			<div class="stats-grid">
				<div class="stat-item">
					<span class="stat-number">$46B</span>
					<span class="stat-label">Contribution To Exports</span>
				</div>
				<div class="stat-item">
					<span class="stat-number">1580+</span>
					<span class="stat-label">GCCs In India</span>
				</div>
				<div class="stat-item">
					<span class="stat-number">1.66M+</span>
					<span class="stat-label">Professionals Employed</span>
				</div>
			</div>
		</div>
	</div>

	<div class="image-gallery">
		<div class="left-images">
			<img src="{{ gcc_img }}/role-img-topleft.webp" class="img-top-left" alt="Modern office space">
			<img src="{{ gcc_img }}/role-img-bottomleft.webp" class="img-bottom-left" alt="Dining area">
		</div>
		<div class="right-image-container">
			<div class="bg-shape"></div>
			<img src="{{ gcc_img }}/role-img-right.webp" class="img-main-right" alt="Living room">
		</div>
	</div>
</section>

<!-- ================= COMPARISON TABLE ================= -->

<section class="main-wrapper comparison-section">
	<header class="comparison-header">
		<p class="subtitle">Hotels vs Serviced Apartments</p>
		<h1>Serviced Apartments vs Hotels</h1>
		<p class="description">
			When GCC employees travel to India, choosing the right accommodation directly impacts cost, comfort, and productivity.
		</p>

		<div class="toggle-container" role="tablist" aria-label="Comparison view">
			<button type="button" class="toggle-btn active" data-view="price" aria-selected="true">
				Price
			</button>
			<button type="button" class="toggle-btn" data-view="amenities" aria-selected="false">
				Amenities
			</button>
		</div>
	</header>

	<div
		class="comparison-card">
		<!-- PRICE VIEW -->
		<div class="comparison-view active" data-view="price">
			<div class="comparison-grid">
				<div class="grid-column sidebar">
					<h3>Compare price across city</h3>
					<div class="city-tabs">
						<button type="button" class="city-tab active">Mumbai</button>
						<button type="button" class="city-tab">Bangalore</button>
						<button type="button" class="city-tab">Delhi-NCR</button>
						<button type="button" class="city-tab">Chennai</button>
						<button type="button" class="city-tab">Hyderabad</button>
						<button type="button" class="city-tab">Pune</button>
					</div>

					{# Row labels #}
					<div class="row-label">7 Nights</div>
					<div class="row-label">15 Nights</div>
					<div class="row-label">1 Month</div>
					<div class="row-label">3 Months</div>
					<div class="row-label">12 Months</div>
				</div>

				{# SERVICED APARTMENTS - Single wrapper with blue border #}
				<div class="serviced-wrapper">
					<div class="column-header">
						<h4>SERVICED APARTMENTS</h4>
						<div class="price-range">₹4,700 — ₹6,800</div>
						<div class="avg-text">Avg. Per night</div>
					</div>

					<div class="serviced-prices">
						<div class="price-item">₹13,500</div>
						<div class="price-item">₹27,000</div>
						<div class="price-item">₹55,000</div>
						<div class="price-item">₹1,50,000</div>
						<div class="price-item">₹5,50,000</div>
					</div>
				</div>

				{# HOTEL COLUMN #}
				<div class="grid-column hotel">
					<div class="column-header">
						<h4>HOTEL (★★★★)</h4>
						<div class="price-range">₹7,500</div>
						<div class="avg-text">Avg. Per night</div>
					</div>

					<div class="row-value">₹21,000</div>
					<div class="row-value">₹45,000</div>
					<div class="row-value">₹90,000</div>
					<div class="row-value">₹2,70,000</div>
					<div class="row-value">₹10,80,000</div>
				</div>
			</div>
		</div>

		<!-- AMENITIES VIEW -->
		<div class="comparison-view" data-view="amenities">
			<div class="comparison-grid amenities-grid">
				<div class="grid-column sidebar">
					<h3>Compare amenities</h3>
					<div class="row-label">Kitchen / Cooking</div>
					<div class="row-label">Laundry</div>
					<div class="row-label">Living Room</div>
					<div class="row-label">Workspace &amp; Wi‑Fi</div>
					<div class="row-label">Housekeeping</div>
				</div>

				{# SERVICED APARTMENTS - Amenities with wrapper #}
				<div class="serviced-wrapper">
					<div class="column-header">
						<h4>SERVICED APARTMENTS</h4>
						<div class="avg-text">Typically Included</div>
					</div>

					<div class="serviced-prices">
						<div class="price-item">
							<span class="amenity yes">✓ Full kitchen</span>
						</div>
						<div class="price-item">
							<span class="amenity yes">✓ In‑unit / on‑site laundry</span>
						</div>
						<div class="price-item">
							<span class="amenity yes">✓ Separate living area</span>
						</div>
						<div class="price-item">
							<span class="amenity yes">✓ High‑speed Wi‑Fi, work desk</span>
						</div>
						<div class="price-item">
							<span class="amenity yes">✓ Flexible housekeeping</span>
						</div>
					</div>
				</div>

				{# HOTEL COLUMN - Amenities #}
				<div class="grid-column hotel">
					<div class="column-header">
						<h4>HOTEL (★★★★)</h4>
						<div class="avg-text">Limited / Extra cost</div>
					</div>

					<div class="row-value">
						<span class="amenity no">✕ No dedicated kitchen</span>
					</div>
					<div class="row-value">
						<span class="amenity maybe">△ Paid laundry service</span>
					</div>
					<div class="row-value">
						<span class="amenity maybe">△ Compact seating</span>
					</div>
					<div class="row-value">
						<span class="amenity yes">✓ Wi‑Fi, but smaller workspace</span>
					</div>
					<div class="row-value">
						<span class="amenity yes">✓ Daily housekeeping</span>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="stats-footer">
		<div class="stat-item">
			<h2>1580+</h2>
			<p>GCCs In India</p>
		</div>
		<div class="divider"></div>
		<div class="stat-item">
			<h2>1.66M+</h2>
			<p>Professionals Employed</p>
		</div>
		<div class="divider"></div>
		<div class="stat-item">
			<h2>$46B</h2>
			<p>Contribution To Exports</p>
		</div>
	</div>


</section>

