<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>StayRelive</title>
  <style>
    html, body {
      margin: 0 auto !important;
      padding: 0 !important;
      height: 100% !important;
      width: 100% !important;
      background: #ffffff !important;
      font-family: Arial, sans-serif !important;
    }
    * {
      -ms-text-size-adjust: 100%;
      -webkit-text-size-adjust: 100%;
    }
    table, td {
      mso-table-lspace: 0pt !important;
      mso-table-rspace: 0pt !important;
    }
    table {
      border-spacing: 0 !important;
      border-collapse: collapse !important;
      table-layout: fixed !important;
      margin: 0 auto !important;
    }
    img {
      -ms-interpolation-mode: bicubic;
      display: block;
      max-width: 100%;
      height: auto;
    }
    a {
      color: #fff;
      text-decoration: underline;
      font-family: Arial, sans-serif !important;
    }
    *[x-apple-data-detectors],
    .unstyle-auto-detected-links *,
    .aBn {
      border-bottom: 0 !important;
      cursor: default !important;
      color: inherit !important;
      text-decoration: none !important;
      font-size: inherit !important;
      font-family: inherit !important;
      font-weight: inherit !important;
      line-height: inherit !important;
    }
    .a6S {
      display: none !important;
      opacity: 0.01 !important;
    }
    img.g-img + div {
      display: none !important;
    }
    .email-section {
      background-color: #1C234F;
      color: #fff;
    }
    @media screen and (max-width: 600px) {
      .email-container {
        width: 100% !important;
      }
      .stack-column, .stack-column-center {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        direction: ltr !important;
      }
      .stack-column-center {
        text-align: center !important;
      }
      .padding-sm {
        padding: 15px !important;
      }
      .heading-section h1 {
        font-size: 24px !important;
      }
      .emailer-copy p {
        font-size: 16px !important;
      }
    }
  </style>
  <meta name="robots" content="noindex, follow">
</head>
<body width="100%" style="margin: 0; padding: 0 !important; mso-line-height-rule: exactly; background-color: #222222; font-family: Arial, sans-serif !important;">
  <center style="width: 100%; background-color: #fff;">
    <div style="max-width: 600px; margin: 0 auto;" class="email-container">
      <!-- LOGO -->
      <table align="center" role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
          <td style="padding: 1em 2.5em; background-color: #fff; text-align: center;">
            <a href="https://www.corphousing.in" target="_blank">
              <img src="https://corphousing.in/themes/srdesign/assets/images/common/new-inner-logo.png" alt="CorpHousing Logo" style="height: 60px; display: block; margin: 0 auto;">
            </a>
          </td>
        </tr>
        <!-- HERO SECTION -->
        <tr>
          <td valign="middle" style="background: url(https://stayrelive.com/themes/srdesign/assets/images/home/hero-3.webp) no-repeat center center / cover; background-color: #1C234F; height: 250px; text-align: center;">
            <div style="height: 250px;">&nbsp;</div>
          </td>
        </tr>
        <!-- MAIN CONTENT -->
        <tr>
          <td style="text-align: center; padding: 30px; background-color: #1590A0; color: #ffffff; font-family: Arial, sans-serif !important;">
            <h2 style="margin: 0; text-align: left;">Welcome To Corporate Housing</h2>
            <div class="emailer-copy" style="font-size: 16px; text-align: left; margin-top: 20px;">
              <p style="margin: 0 0 5px 0;">Hello {{ first_name }} {{ last_name }},</p>
              <p style="margin: 0 0 5px 0;">A request to reset the password for your account has been made at {{ site_name }}.</p>
              <p style="margin: 0 0 5px 0;">Click the button below to reset your password:</p>
              <!-- Reset Password Button -->
              <p style="text-align: center; margin: 30px 0;">
                <a href="{{ reset_url }}" target="_blank" style="background-color: #ffffff; color: #1590A0; padding: 12px 24px; font-size: 16px; font-weight: bold; text-decoration: none; border-radius: 4px; display: inline-block; font-family: Arial, sans-serif !important;">
                  Reset Your Password
                </a>
              </p>
              <p>This link can only be used once and will lead you to a page where you can set your password. It expires after one day and will have no effect if unused.</p>
              <p>- Team {{ site_name }}</p>
            </div>
          </td>
        </tr>
        <!-- SOCIAL FOOTER -->
        <tr>
          <td style="padding: 30px; background-color: #f0efef; text-align: center; color: #333; font-family: Arial, sans-serif !important;">
            <h2 style="margin-bottom: 20px;">Corporate Housing</h2>
            <table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin: 0 auto 20px;">
              <tr class="social-icons">
                <td style="padding: 0 5px;">
                  <a href="https://www.instagram.com/stayrelive" target="_blank">
                    <img src="https://cdn-icons-png.flaticon.com/512/1077/1077042.png" alt="Instagram" width="32" height="32" />
                  </a>
                </td>
                <td style="padding: 0 5px;">
                  <a href="https://www.linkedin.com/company/stayrelive/?viewAsMember=true" target="_blank">
                    <img src="https://cdn-icons-png.flaticon.com/512/13266/13266142.png" alt="LinkedIn" width="32" height="32" />
                  </a>
                </td>
                <td style="padding: 0 5px;">
                  <a href="https://www.facebook.com/StayRelive/" target="_blank">
                    <img src="https://cdn-icons-png.flaticon.com/512/13266/13266170.png" alt="Facebook" width="32" height="32" />
                  </a>
                </td>
                <td style="padding: 0 5px;">
                  <a href="https://wa.me/916362730626" target="_blank">
                    <img src="https://cdn-icons-png.flaticon.com/512/466/466966.png" alt="WhatsApp" width="32" height="32" />
                  </a>
                </td>
                <td style="padding: 0 5px;">
                  <a href="https://x.com/StayRelive" target="_blank">
                    <img src="https://cdn-icons-png.flaticon.com/512/14417/14417460.png" alt="Twitter" width="32" height="32" />
                  </a>
                </td>
              </tr>
            </table>
            <hr style="margin: 30px auto 15px; border: none; border-top: 1px solid #ccc; width: 80%;" />
            <p style="margin: 0; font-size: 13px; color: #777;">&copy; {{ current_year }} StayRelive. All rights reserved.</p>
          </td>
        </tr>
      </table>
    </div>
  </center>
</body>
</html>
