<body style="margin: 0; padding: 0; font-family: 'Roboto', Arial, sans-serif;">
	<style type="text/css">
		/* Override email client link styles - target all possible selectors */
		td a[href^="mailto:"],
		td p a[href^="mailto:"],
		td p span a[href^="mailto:"],
		.emailer-copy a[href^="mailto:"],
		.emailer-copy li a,
		.ii a[href],
		.ii a[href^="mailto:"],
		.gt a,
		.gt a[href^="mailto:"],
		td p span a[href],
		td p a[href],
		* a[href^="mailto:"] {
			color: #ffffff !important;
			text-decoration: none !important;
		}
		/* Target any anchor within the content area */
		td[style*="background-color: #1590A0"] a,
		td[style*="background-color: #1590A0"] p a,
		td[style*="background-color: #1590A0"] p span a,
		td[style*="background-color: #1590A0"] .ii a,
		td[style*="background-color: #1590A0"] .gt a {
			color: #ffffff !important;
			text-decoration: none !important;
		}
	</style>
	<center style="width: 100%;">
		<table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse;">
			<tr>
				<td valign="top" style="padding: 0;">
					<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="650" style="border-collapse: collapse; background-color: #ffffff; margin: 0 auto;">
						<tr>
							<td style="padding: 0;">
								<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
									<tr>
										<td style="text-align: center; padding: 20px 0;">
											<a href="https://corphousing.in" target="_blank" style="text-decoration: none;">
												<img src="https://corphousing.in/themes/srdesign/assets/images/common/new-inner-logo.png" alt="CorpHousing Logo" width="auto" height="50" style="display: block; margin: 0 auto; border: 0;"/>
											</a>
										</td>
									</tr>
								</table>

								<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
									<tr>
										<td style="padding: 0;">
											<img src="https://stayrelive.com/themes/srdesign/assets/images/home/hero.webp" alt="StayRelive Hero" width="650" height="300" style="display: block; border: 0; max-width: 100%; height: auto;"/>
										</td>
									</tr>
								</table>
							</td>
						</tr>

						<tr>
							<td style="text-align: center; padding: 30px; background-color: #1590A0; color: #ffffff; font-family: 'Roboto', Arial, sans-serif !important;">

								<p style="margin: 0; text-align: left; font-size: 16px;">
									Dear <span style="font-weight: bold; color: #ffffff !important;"><a href="mailto:{{ user.mail.value }}" style="color: #ffffff !important; text-decoration: none !important; font-weight: bold;">{{ user.getDisplayName() }}</a></span>,
								</p>

								<div class="emailer-copy" style="font-size: 16px; text-align: left; margin-top: 20px;">

									<p>
										Your account at
										<strong>{{ site_name }}</strong>
										has been successfully activated.
									</p>

									<h3 style="margin-top: 25px;">Your Account Details:</h3>

									<ul style="padding-left: 20px;">
										<li>
											<strong>Email:</strong>
											<a href="mailto:{{ user.mail.value }}" style="color: #ffffff !important; text-decoration: none !important;">{{ user.mail.value }}</a>
										</li>
									</ul>

									<p>
										You will be able to log in at CorpHousing using the link below:
									</p>

									<!-- Login Button -->
									<p style="text-align: center; margin: 30px 0;">
										<a href="https://corphousing.in/user/login" target="_blank" style="
												          background-color: #ffffff;
												          color: #1590A0;
												          padding: 12px 24px;
												          font-size: 16px;
												          font-weight: bold;
												          text-decoration: none;
												          border-radius: 4px;
												          display: inline-block;
												          font-family: 'Roboto', Arial, sans-serif !important;">
											Login to CorpHousing
										</a>
									</p>

									<p style="margin: 0 0 5px 0;">We look forward to serving you!</p>
									<p style="margin: 0 0 5px 0;">Warm regards,</p>
									<p style="margin: 0 0 5px 0;">Team StayRelive</p>
									<p style="margin-top: 20px; font-size: 16px;">
										Email:
										<a href="mailto:book@stayrelive.com" style="color: #ffffff !important; text-decoration: none !important;">book@stayrelive.com</a>
									</p>
									<p style="margin: 0; font-size: 16px;">
										Phone: +971 55 107 6902
									</p>

								</div>
							</td>
						</tr>

					</p>
				</td>
			</tr>
		</div>
	</td>
</body></tr><tr>
