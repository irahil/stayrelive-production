<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title>Verify Your Account</title>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;600&display=swap" rel="stylesheet">
  <style>
    @media (prefers-color-scheme: dark) { .dark-bg { background-color: #ffffff !important; } }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#ffffff; font-family:'Roboto', Arial, sans-serif;">
  <center style="width:100%; background-color:#ffffff;" class="dark-bg">
    <table width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center" style="padding:40px 0;">
          <table width="600" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff; border-radius:8px; overflow:hidden; border:1px solid #eeeeee;" class="dark-bg">
            <tr>
              <td align="center" style="padding:25px;"><img src="https://corphousing.in/themes/srdesign/assets/images/common/new-inner-logo.png" height="60" style="display:block;"></td>
            </tr>
            <tr>
              <td><img src="https://stayrelive.com/themes/srdesign/assets/images/home/hero-3.webp" width="600" style="display:block; width:100%; height:auto;"></td>
            </tr>
            <tr>
              <td style="padding:40px 30px; background:#f9f9f9; color:#000000; font-size:16px; line-height:24px;">
                <p>Dear <strong>{{ user.name.value }}</strong>,</p>
                <p>Please verify your email to start exploring StayRelive.</p>
                <div style="margin:20px 0; border-left:4px solid #D6E4FF; padding-left:15px; background:#ffffff; padding:15px;">
                  <p style="margin:0; font-weight:600;">Registered Email:</p>
                  <p style="margin:0;">{{ user.mail.value }}</p>
                </div>
                <table align="center" style="margin:30px auto;">
                  <tr>
                    <td bgcolor="#D6E4FF" style="border-radius:5px;"><a href="{{ verification_link }}" style="display:inline-block; padding:14px 30px; font-size:16px; color:#1D1D1D; font-weight:bold; text-decoration:none;">Verify My Account</a></td>
                  </tr>
                </table>
                <p>Warm regards,<br><strong>Team StayRelive</strong></p>
                <hr style="border:none; border-top:1px solid #e0e0e0; margin:30px 0;">
                <p style="margin:0; font-size:14px;">Email: <a href="mailto:contact@corphousing.in" style="color:#1D1D1D; text-decoration:none; font-weight:600;">contact@corphousing.in</a></p>
                <p style="margin:5px 0 0; font-size:14px;">Phone: <a href="tel:+918657894083" style="color:#1D1D1D; text-decoration:none;">+91 86578 94083</a> | <a href="tel:+918657894483" style="color:#1D1D1D; text-decoration:none;">+91 86578 94483</a></p>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:40px 30px; background:#f9f9f9; text-align:center;">
                <h2 style="margin:0 0 20px; font-size:22px;">StayRelive</h2>
                <table align="center" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <td style="padding:0 8px;"><a href="https://www.instagram.com/stayrelive" target="_blank"><img src="https://cdn-icons-png.flaticon.com/512/1077/1077042.png" width="28" height="28"></a></td>
                    <td style="padding:0 8px;"><a href="https://www.linkedin.com/company/stayrelive/" target="_blank"><img src="https://cdn-icons-png.flaticon.com/512/13266/13266142.png" width="28" height="28"></a></td>
                    <td style="padding:0 8px;"><a href="https://www.facebook.com/StayRelive/" target="_blank"><img src="https://cdn-icons-png.flaticon.com/512/13266/13266170.png" width="28" height="28"></a></td>
                    <td style="padding:0 8px;"><a href="https://wa.me/916362730626" target="_blank"><img src="https://cdn-icons-png.flaticon.com/512/466/466966.png" width="28" height="28"></a></td>
                    <td style="padding:0 8px;"><a href="https://x.com/StayRelive" target="_blank"><img src="https://cdn-icons-png.flaticon.com/512/14417/14417460.png" width="28" height="28"></a></td>
                  </tr>
                </table>
                <p style="margin:25px 0 0; font-size:12px; color:#999999;">&copy; {{ "now"|date("Y") }} StayRelive. All rights reserved.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </center>
</body>
</html>