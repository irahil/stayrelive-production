/**
 * Implements hook_mail().
 */
function ch_property_mail($key, &$message, $params)
{
  switch ($key) {

    case 'welcome_user':
      $build = [
        '#theme' => 'ch_property_welcome_mail',
        '#user' => $params['user'],
        '#verification_link' => $params['verification_link'],
      ];

      $rendered = \Drupal::service('renderer')->render($build);
      $rendered_string = (string) $rendered;

      $message['subject'] = $params['subject'];
      $message['body'] = [$rendered_string];
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
      $message['headers']['MIME-Version'] = '1.0';
      $message['headers']['Content-Transfer-Encoding'] = '8bit';
      break;

    case 'forgot_password':
      $build = [
        '#theme' => 'ch_property_forgot_password_mail',
        '#user' => $params['user'],
        '#reset_link' => $params['reset_link'],
      ];

      $rendered = \Drupal::service('renderer')->render($build);
      $message['subject'] = $params['subject'];
      $message['body'] = [(string) $rendered];
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
      $message['headers']['MIME-Version'] = '1.0';
      $message['headers']['Content-Transfer-Encoding'] = '8bit';
      break;

    case 'account_activated':
      $build = [
        '#theme' => 'ch_property_account_activated_mail',
        '#user' => $params['user'],
      ];

      $rendered = \Drupal::service('renderer')->render($build);

      $message['subject'] = 'Your StayRelive account is now active';
      $message['body'] = [(string) $rendered];
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
      $message['headers']['MIME-Version'] = '1.0';
      $message['headers']['Content-Transfer-Encoding'] = '8bit';
      break;

  }
}

/**
 * Implements hook_mail_alter().
 */
function ch_property_mail_alter(&$message)
{
  // Disable Drupal core's default user registration email.
  if ($message['id'] === 'user_registrationpassword_register_confirmation_with_pass') {
    $message['send'] = FALSE;
  }

  // Disable admin-created account email (optional)
  if ($message['id'] === 'user_register_admin_created') {
    $message['send'] = FALSE;
  }

  // Disable verification email (optional)
  if ($message['id'] === 'user_register_pending_approval') {
    $message['send'] = FALSE;
  }

  // Disable Drupal core's "forgot password" email
  if ($message['id'] === 'user_password_reset') {
    $message['send'] = FALSE;

    $user = $message['params']['account'];
    $langcode = $user->getPreferredLangcode();
    $reset_link = user_pass_reset_url($user);

    $params = [
      'subject' => 'Reset your password - StayRelive',
      'user' => $user,
      'reset_link' => $reset_link,
    ];

    \Drupal::service('plugin.manager.mail')->mail(
      'ch_property',
      'forgot_password',
      $user->getEmail(),
      $langcode,
      $params,
      NULL,
      TRUE
    );
  }

  // Block Drupal core "account activated" email
  if ($message['id'] === 'user_status_activated') {
    $message['send'] = FALSE;

    $user = $message['params']['account'];
    $langcode = $user->getPreferredLangcode();

    \Drupal::service('plugin.manager.mail')->mail(
      'ch_property',
      'account_activated',
      $user->getEmail(),
      $langcode,
      [
        'user' => $user,
      ],
      NULL,
      TRUE
    );
  }
}

function ch_property_form_views_exposed_form_alter(
  array &$form,
  FormStateInterface $form_state,
  $form_id
) {
  if ($form['#id'] !== 'views-exposed-form-property-search-block-1') {
    return;
  }

  /* ---------------------------------
   * CITY FILTER (hidden but active)
   * --------------------------------- */
  if (isset($form['field_city_target_id'])) {
    $request = \Drupal::request();
    $form['field_city_target_id']['#access'] = FALSE;

    if ($request->query->has('field_city_target_id')) {
      $form['field_city_target_id']['#default_value'] =
        $request->query->get('field_city_target_id');
    }
  }

  /* ---------------------------------
   * PROPERTY TYPE → RADIOS
   * --------------------------------- */
  if (!isset($form['field_property_type_target_id'])) {
    return;
  }

  $element = &$form['field_property_type_target_id'];
  $element['#type'] = 'radios';

  if (
    empty($element['#default_value']) ||
    !isset($element['#options'][$element['#default_value']])
  ) {
    $element['#default_value'] = NULL;
  }

  $element['#attributes']['class'][] = 'property-type-radios';
  $form['#cache']['max-age'] = 0;
}