{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "drupal/admin_toolbar": "3.5",
        "drupal/better_exposed_filters": "7.0",
        "drupal/block_class": "3.0",
        "drupal/blog": "^3.1",
        "drupal/core-composer-scaffold": "^10.0",
        "drupal/core-project-message": "^10.0",
        "drupal/core-recommended": "10.1.0",
        "drupal/ctools": "^4.0",
        "drupal/datetime_flatpickr": "^2.0",
        "drupal/delete_all": "3.0",
        "drupal/entity_reference_revisions": "^1.10",
        "drupal/extra_image_field_classes": "^1.2",
        "drupal/faqfield": "^8.0",
        "drupal/field_group": "^3.6",
        "drupal/flag": "^4.0@beta",
        "drupal/flexslider": "^3.0@alpha",
        "drupal/geolocation": "^3.13",
        "drupal/google_map_field": "2.0",
        "drupal/jquery_ui_accordion": "^2.1",
        "drupal/mail_login": "^2.8",
        "drupal/mailsystem": "^4.4",
        "drupal/metatag": "^2.0",
        "drupal/mimemail": "^1.0@alpha",
        "drupal/page_specific_class": "^2.0",
        "drupal/paragraphs": "^1.15",
        "drupal/pathauto": "^1.11",
        "drupal/phpmailer_smtp": "^2.2",
        "drupal/recaptcha": "3.3",
        "drupal/remove_username": "^1.3",
        "drupal/shield": "^1.7",
        "drupal/simple_pass_reset": "^1.2",
        "drupal/slick": "^3.0",
        "drupal/slick_extras": "^2.0",
        "drupal/slick_views": "^3.0",
        "drupal/smtp": "^1.2",
        "drupal/social_auth_facebook": "^4.0",
        "drupal/social_auth_google": "4.0",
        "drupal/symfony_mailer": "^1.3",
        "drupal/token": "^1.12",
        "drupal/twig_tweak": "^3.3",
        "drupal/user_registrationpassword": "^2.0",
        "drupal/views_accordion": "^2.0",
        "drupal/webform": "^6.2",
        "drupal/webform_views": "^5.5",
        "drush/drush": "^12.5",
        "mpdf/mpdf": "8.2",
        "phayes/geophp": "^1.2",
        "spipu/html2pdf": "^5.2"
    },
    "require-dev": {
        "drupal/core-dev": "^10.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/profiles/custom/{$name}": ["type:drupal-custom-profile"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"]
        },
        "enable-patching": true,
        "patches": {
            "drupal/core": {
                "core_datetime_exposed_filter": "https://www.drupal.org/files/issues/2022-11-18/2648950-270.patch"
            },
            "drupal/user_registrationpassword": {
                "3467248 - TypeError: Return value must be of type array, bool returned(https://www.drupal.org/project/user_registrationpassword/issues/3467248)": "https://www.drupal.org/files/issues/2024-09-03/user_registrationpassword-3467248-17.patch"
            }
        }
    }
}
